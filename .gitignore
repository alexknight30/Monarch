# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-check/
/.next-build/
/data/*/profile.json
/data/*/chats.json
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# syllabus uploads (JSON stores are committed; PDFs are not)
data/*/uploads/
data/*/chat-files/
data/*/assets/
data/provider-files/
data/backups/
data/*/workspace.json
data/*/trash.json
data/*/.write-lock/
data/*/*.tmp
